{
  "manifest_version": 3,
  "name": "视频画中画 Plus",
  "version": "1.2.1",
  "description": "任意网页视频一键画中画：浮动小窗，宽度和高度随意拖拽调整，自动记住你的偏好尺寸。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus", "scripting", "downloads", "offscreen", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "视频画中画",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-pip": {
      "suggested_key": { "default": "Alt+P" },
      "description": "开启 / 关闭画中画"
    }
  }
}
